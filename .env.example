# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_REFRESH_SECRET=change-me-refresh-to-a-different-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_tickets
DB_USER=postgres
DB_PASSWORD=postgres
DB_TEST_NAME=hotel_tickets_test
DB_SSL=false

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# SMTP (Email Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Hotel Ticketing System <your_gmail_address@gmail.com>"
SMTP_ENABLED=false

# Rate Limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Account Lockout
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Timezone (for SLA calculations)
APP_TIMEZONE=Indian/Mauritius

# App
APP_NAME=Hotel Operations System
APP_VERSION=1.0.0
APP_URL=http://localhost:5173
